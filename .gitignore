# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Local tool downloads (quarto CLI tarball, etc.) - not part of the repo
.tools/

# rv already ships its own rv/.gitignore (ignores rv/library/) in each
# rv-managed subproject (r/, examples/demo-report/) - nothing needed here.

# Generated build artifacts - regenerate with `quartifyr-styling build`.
# org-reference.docx is the one exception: it's committed on purpose so
# the two bundled examples (and a first-time user) have a working
# reference-doc without needing the styling/ Python venv set up first --
# see scripts/check_template_freshness.py, which guards against it
# drifting from styling/styles/default.yaml, and the repo-root README's
# "Style YAML and reference-doc" section.
templates/*.docx
!templates/org-reference.docx

# Quarto render intermediates
/.quarto/
*_files/

# reportifyr working documents (project-specific, not toolkit source)
examples/*/report/shell/*.docx
# Quarto copies referenced assets (e.g. a title-page logo, or a
# synopsis figure pulled from OUTPUTS/) into the output-dir alongside the
# rendered docx -- a render byproduct, not source (the source lives at
# examples/*/assets/ and examples/*/OUTPUTS/ respectively).
examples/*/report/shell/assets/
examples/*/report/shell/OUTPUTS/
examples/*/abbreviations.tex
examples/*/report/draft/*
examples/*/report/final/*
!examples/*/report/draft/readme.txt
!examples/*/report/final/readme.txt

# reportifyr project-init marker (personal: embeds username/timestamp) and
# runtime logs - regenerate via reportifyr::initialize_report_project()
examples/*/.report_init.json
examples/*/.rpfy-logs/
# Note: examples/*/OUTPUTS/ artifacts (csv/png/metadata.json) ARE committed,
# like reportifyr-examples does -- the demo project works immediately after
# a clone without requiring scripts/01_analysis.R to run first.

# OS
.DS_Store

# Jekyll build artifacts (docs/ site), only present after a local `jekyll build`/`bundle exec jekyll serve`
docs/_site/
docs/.jekyll-cache/
docs/.jekyll-metadata

# Personal Claude Code permissions/settings, not project source
.claude/

# uv.lock is only generated by ad-hoc `uv run`/`uv venv` use of styling/,
# not part of the packaged tool -- styling/pyproject.toml is the source of
# truth for dependencies.
styling/uv.lock
