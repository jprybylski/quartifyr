{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jprybylski.github.io/quartifyr/check-result-v1.schema.json",
  "title": "quartifyr project check result",
  "description": "What `Rscript inst/scripts/check.R --json` prints on stdout. Exit status is 0 when no finding has severity \"error\", 1 when one does, 2 for bad usage. Same compatibility rule as render-result-v1.schema.json.",
  "type": "object",
  "required": [
    "schema_version",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "severity",
          "path",
          "message"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
